# ==============================================================================
# BotNexa Platform - Root Environment Example
# Copy this file to server/.env and fill in your values for local development
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_PUBLIC_URL=http://localhost:3000

# PostgreSQL with pgvector
DATABASE_URL=postgresql://botnexa:botnexa123@localhost:5432/botnexa?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=botnexa
POSTGRES_PASSWORD=botnexa123
POSTGRES_DB=botnexa
POSTGRES_SSL=false

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_PROVIDER=gemini

# JWT & Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d
